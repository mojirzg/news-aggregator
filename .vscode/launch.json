{
  "version": "0.2.0",

  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend (TypeScript)",

      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],

      "program": "${workspaceFolder}/src/server/index.ts",
      "cwd": "${workspaceFolder}",

      "envFile": "${workspaceFolder}/.env",
      "env": {
        "NODE_ENV": "development"
      },

      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",

      "sourceMaps": true,
      "smartStep": true,

      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ],

      "resolveSourceMapLocations": [
        "${workspaceFolder}/src/**",
        "!**/node_modules/**"
      ]
    },

    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Run Frontend",
      "command": "pnpm run dev:client",
      "cwd": "${workspaceFolder}"
    },

    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Run Tests in Watch Mode",
      "command": "pnpm run test:watch",
      "cwd": "${workspaceFolder}"
    }
  ],

  "compounds": [
    {
      "name": "Debug Full Stack",
      "configurations": ["Debug Backend (TypeScript)", "Run Frontend"]
    }
  ]
}
